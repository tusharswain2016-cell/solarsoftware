let curLang='en';
function applyLang(l){
    curLang=l;const t=T[l]||T.en;
    document.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.getAttribute('data-i18n');if(t[k]!==undefined)el.textContent=t[k];});
    document.querySelectorAll('.lang-btn').forEach(b=>b.classList.toggle('active',b.dataset.lang===l));
    document.documentElement.lang=l;
}
document.querySelectorAll('.lang-btn').forEach(b=>b.addEventListener('click',()=>applyLang(b.dataset.lang)));

// ─── MODAL — FIXED ───
// Key fixes:
// 1. Separated menu-open and modal-open body classes
// 2. Always close menu first, THEN open modal in next frame
// 3. modal display is toggled via class, no inline style conflicts
// 4. Removed position:fixed from body.menu-open (caused page jump + modal misfire)

const modal = document.getElementById('demoModal');
const closeModalBtn = document.getElementById('closeModal');
const demoForm = document.getElementById('demoForm');

function openModal() {
    // First close mobile menu if open
    closeMobileMenu();
    // Then open modal in next paint frame so menu close finishes first
    requestAnimationFrame(() => {
        modal.style.display = 'flex';
        // Force reflow for transition
        modal.offsetHeight;
        modal.classList.add('active');
        document.body.classList.add('modal-open');
        // Focus first input for accessibility
        setTimeout(() => {
            const first = modal.querySelector('input');
            if (first) first.focus();
        }, 50);
    });
}

function closeModal() {
    modal.classList.remove('active');
    document.body.classList.remove('modal-open');
    // Hide after transition completes
    setTimeout(() => {
        if (!modal.classList.contains('active')) {
            modal.style.display = 'none';
        }
    }, 300);
}

// Attach to all demo trigger buttons/links
document.querySelectorAll('.demo-trigger').forEach(trigger => {
    trigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openModal();
    });
});

closeModalBtn.addEventListener('click', closeModal);

// Click outside modal content to close
modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
});

// ESC key to close
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
});

// ─── FORM HELPERS ───
function collectFormData() {
    return {
        name: demoForm.querySelector('[name="name"]').value.trim(),
        email: demoForm.querySelector('[name="email"]').value.trim(),
        phone: demoForm.querySelector('[name="phone"]').value.trim(),
        company: demoForm.querySelector('[name="company"]').value.trim(),
        message: demoForm.querySelector('[name="message"]').value.trim()
    };
}

function buildWAMessage(data) {
    let msg = `Hi, I am interested in Solar Software Demo.\n\n`;
    msg += `*Name:* ${data.name}\n`;
    msg += `*Email:* ${data.email}\n`;
    msg += `*Phone:* ${data.phone}\n`;
    if (data.company) msg += `*Company:* ${data.company}\n`;
    if (data.message) msg += `*Message:* ${data.message}\n`;
    return encodeURIComponent(msg);
}

async function sendEmail(data) {
    const formData = new FormData();
    formData.append('name', data.name);
    formData.append('email', data.email);
    formData.append('phone', data.phone);
    formData.append('company', data.company);
    formData.append('message', data.message);
    formData.append('_subject', 'New Solar Software Demo Request');
    formData.append('_captcha', 'false');
    formData.append('_template', 'table');
    try {
        await fetch(`https://formsubmit.co/${EMAIL}`, {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
        });
    } catch(e) { /* silent fail — WA still opens */ }
}

// Main form submit — validate → email → WhatsApp
demoForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = collectFormData();
    if (!data.name || !data.email || !data.phone) {
        // Highlight missing fields
        ['name','email','phone'].forEach(field => {
            const el = demoForm.querySelector(`[name="${field}"]`);
            if (!el.value.trim()) {
                el.style.borderColor = '#e53e3e';
                el.addEventListener('input', () => el.style.borderColor = '', { once: true });
            }
        });
        return;
    }
    sendEmail(data); // fire and forget
    const waMsg = buildWAMessage(data);
    closeModal();
    demoForm.reset();
    window.open(`https://wa.me/${WA_PRIMARY}?text=${waMsg}`, '_blank');
    setTimeout(() => alert('✅ Thank you! We will contact you soon. WhatsApp has also opened for a quick response.'), 400);
});

// WhatsApp-only button
document.getElementById('waSubmitBtn').addEventListener('click', function() {
    const data = collectFormData();
    if (!data.name || !data.phone) {
        ['name','phone'].forEach(field => {
            const el = demoForm.querySelector(`[name="${field}"]`);
            if (!el.value.trim()) {
                el.style.borderColor = '#e53e3e';
                el.addEventListener('input', () => el.style.borderColor = '', { once: true });
            }
        });
        return;
    }
    sendEmail(data);
    const waMsg = buildWAMessage(data);
    closeModal();
    demoForm.reset();
    window.open(`https://wa.me/${WA_PRIMARY}?text=${waMsg}`, '_blank');
});

// ─── MOBILE MENU — FIXED ───
// Separated from modal logic completely
const mBtn = document.getElementById('mobileMenuBtn');
const nMenu = document.getElementById('navMenu');
const nRight = document.getElementById('navRight');
const mOverlay = document.getElementById('mobileOverlay');

function closeMobileMenu() {
    nMenu.classList.remove('active');
    if (nRight) nRight.classList.remove('active');
    if (mOverlay) mOverlay.classList.remove('active');
    // Only remove menu-open, never remove modal-open here
    document.body.classList.remove('menu-open');
    mBtn.textContent = '☰';
}

function toggleMobileMenu(e) {
    e.stopPropagation();
    const isOpen = nMenu.classList.contains('active');
    if (isOpen) {
        closeMobileMenu();
    } else {
        nMenu.classList.add('active');
        if (nRight) nRight.classList.add('active');
        if (mOverlay) mOverlay.classList.add('active');
        document.body.classList.add('menu-open');
        mBtn.textContent = '✕';
    }
}

mBtn.addEventListener('click', toggleMobileMenu);

// Close menu when nav links are clicked (but NOT demo trigger links — those open modal)
document.querySelectorAll('.nav-center a:not(.demo-trigger)').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
});

if (mOverlay) mOverlay.addEventListener('click', closeMobileMenu);

// ─── SMOOTH SCROLL ───
document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', function(e) {
        const h = this.getAttribute('href');
        if (h !== '#' && h !== '' && !this.classList.contains('demo-trigger')) {
            e.preventDefault();
            const t = document.querySelector(h);
            if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
});

// ─── SCROLL REVEAL ───
const revObs = new IntersectionObserver((entries, o) => {
    entries.forEach(e => {
        if (e.isIntersecting) {
            e.target.classList.add('active');
            o.unobserve(e.target);
        }
    });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.reveal').forEach(el => revObs.observe(el));

// ─── HEADER SHADOW ───
window.addEventListener('scroll', () => {
    document.querySelector('header').style.boxShadow = window.scrollY > 40
        ? '0 4px 24px rgba(0,0,0,.1)'
        : '0 2px 12px rgba(0,0,0,.06)';
}, { passive: true });

// ─── ANIMATED COUNTER ───
function animateCounter(el) {
    const target = parseInt(el.dataset.counter);
    const suffix = el.dataset.suffix || '';
    const duration = 2000;
    const steps = 60;
    const increment = target / steps;
    let step = 0;
    const timer = setInterval(() => {
        step++;
        const current = Math.min(Math.round(increment * step), target);
        el.textContent = target >= 10000
            ? (current / 1000).toFixed(0) + 'K' + suffix
            : current + suffix;
        if (step >= steps) clearInterval(timer);
    }, duration / steps);
}
const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.querySelectorAll('[data-counter]').forEach(el => animateCounter(el));
            statsObs.unobserve(entry.target);
        }
    });
}, { threshold: 0.3 });
document.querySelectorAll('.stats-section, .hero-stats').forEach(s => statsObs.observe(s));

