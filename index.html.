<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>India's Best Solar CRM Software – Project Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --orange: #FF7B19;
            --orange-light: #ff9d4d;
            --orange-pale: rgba(255,123,25,0.08);
            --dark: #1a202c;
            --mid: #2d3748;
            --text: #4a5568;
            --muted: #718096;
            --border: #e2e8f0;
            --bg-light: #f7fafc;
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        html { overflow-x:hidden; scroll-behavior:smooth; }
        body { font-family:'Plus Jakarta Sans',-apple-system,sans-serif; color:var(--mid); line-height:1.6; overflow-x:hidden; width:100%; }
        img { max-width:100%; height:auto; display:block; }
        a { text-decoration:none; color:inherit; }
        button { cursor:pointer; border:none; font-family:inherit; }

        .container { max-width:1200px; margin:0 auto; padding:0 24px; width:100%; }
        section { width:100%; overflow-x:hidden; }

        .btn { display:inline-flex; align-items:center; gap:8px; padding:14px 32px; border-radius:10px; font-weight:700; font-size:16px; transition:all 0.3s ease; position:relative; overflow:hidden; cursor:pointer; }
        .btn-primary { background:var(--dark); color:white; box-shadow:0 4px 20px rgba(0,0,0,0.2); }
        .btn-primary:hover { background:#111; transform:translateY(-3px); box-shadow:0 12px 30px rgba(0,0,0,0.3); }
        .btn-orange { background:linear-gradient(135deg,var(--orange),var(--orange-light)); color:white; box-shadow:0 4px 20px rgba(255,123,25,0.35); }
        .btn-orange:hover { transform:translateY(-3px); box-shadow:0 12px 30px rgba(255,123,25,0.45); }

        .section-tag { display:inline-block; padding:6px 18px; background:var(--orange-pale); color:var(--orange); border-radius:30px; font-weight:700; font-size:13px; letter-spacing:.5px; margin-bottom:16px; }
        .section-title { font-size:42px; font-weight:800; color:var(--dark); margin-bottom:16px; line-height:1.15; }
        .section-subtitle { font-size:18px; color:var(--muted); max-width:680px; margin:0 auto 56px; }

        .reveal { opacity:0; transform:translateY(32px); transition:opacity .9s ease, transform .9s ease; }
        .reveal.active { opacity:1; transform:translateY(0); }
        .reveal-delay-1 { transition-delay:.1s; }
        .reveal-delay-2 { transition-delay:.2s; }
        .reveal-delay-3 { transition-delay:.3s; }

        @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
        @keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.04)} }
        @keyframes glow { 0%,100%{box-shadow:0 0 18px rgba(255,123,25,0.3)} 50%{box-shadow:0 0 36px rgba(255,123,25,0.6)} }
        @keyframes shimmer { 0%{background-position:200% center} 100%{background-position:-200% center} }
        @keyframes countUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }

        /* WhatsApp Float Button */
        .whatsapp-float {
            position: fixed;
            bottom: 28px;
            right: 28px;
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 10px;
            background: #25D366;
            color: white;
            padding: 14px 20px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 15px;
            box-shadow: 0 6px 28px rgba(37,211,102,0.45);
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            animation: waPulse 2.5s ease-in-out infinite;
        }
        .whatsapp-float:hover {
            background: #128C7E;
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 12px 36px rgba(37,211,102,0.55);
            animation: none;
        }
        .whatsapp-float svg { width:24px; height:24px; flex-shrink:0; }
        @keyframes waPulse {
            0%,100% { box-shadow: 0 6px 28px rgba(37,211,102,0.45); }
            50% { box-shadow: 0 6px 40px rgba(37,211,102,0.75); }
        }
        @media(max-width:480px){
            .whatsapp-float { padding:13px 16px; font-size:13px; bottom:18px; right:14px; }
            .whatsapp-float .wa-label { display:none; }
        }

        /* LANG */
        .lang-switcher { display:flex; align-items:center; gap:5px; }
        .lang-btn { background:none; border:1.5px solid var(--border); border-radius:6px; padding:4px 10px; font-size:13px; font-weight:700; color:var(--text); cursor:pointer; transition:all .2s; font-family:inherit; }
        .lang-btn:hover { border-color:var(--orange); color:var(--orange); }
        .lang-btn.active { background:var(--orange); border-color:var(--orange); color:white; }

        /* TOP BAR */
        .top-bar { background:var(--dark); padding:9px 0; }
        .top-bar-content { display:flex; justify-content:flex-end; align-items:center; gap:28px; font-size:13px; }
        .top-bar-link { color:#a0aec0; font-weight:500; transition:color .2s; display:flex; align-items:center; gap:6px; }
        .top-bar-link:hover { color:var(--orange); }

        /* HEADER */
        /* 
         * FIX: Removed position:fixed and width:100% from body.menu-open
         * This was causing the page to shift and the modal to misfire on mobile.
         * We now use a separate body class for modal-open state.
         */
        .mobile-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:999; opacity:0; transition:opacity .3s; }
        .mobile-overlay.active { display:block; opacity:1; }
        /* menu-open: only prevent scroll, no position:fixed to avoid layout shift */
        body.menu-open { overflow:hidden; }
        /* modal-open: same, just block scroll */
        body.modal-open { overflow:hidden; }

        header { background:white; box-shadow:0 2px 12px rgba(0,0,0,.06); position:sticky; top:0; z-index:1000; transition:box-shadow .3s; }
        nav { display:flex; justify-content:space-between; align-items:center; padding:16px 0; min-height:76px; }
        .logo-container { display:flex; align-items:center; gap:10px; }
        .logo-container img { height:48px; width:auto; }
        .nav-center { display:flex; align-items:center; gap:36px; list-style:none; }
        .nav-center a { font-weight:600; color:var(--mid); transition:color .2s; padding:8px 0; font-size:15px; position:relative; }
        .nav-center a::after { content:''; position:absolute; bottom:0; left:0; width:0; height:2px; background:var(--orange); transition:width .3s; }
        .nav-center a:hover::after { width:100%; }
        .nav-center a:hover { color:var(--orange); }
        .nav-right { display:flex; align-items:center; gap:16px; }
        .mobile-menu-btn { display:none; background:none; font-size:26px; color:var(--dark); padding:8px; cursor:pointer; }

        /* MODAL */
        .modal {
            display:none;
            position:fixed;
            z-index:2000;
            inset:0;
            background:rgba(0,0,0,.72);
            /* FIX: Use flex always; toggle visibility via opacity + pointer-events */
            justify-content:center;
            align-items:center;
            /* Smooth fade in */
            opacity:0;
            transition: opacity 0.25s ease;
        }
        /* FIX: Two-step show — display block first, then opacity for animation */
        .modal.active {
            display:flex;
            opacity:1;
        }
        .modal-content {
            background:white;
            padding:40px;
            border-radius:20px;
            max-width:500px;
            width:92%;
            position:relative;
            animation:slideDown .35s ease;
            box-shadow:0 24px 60px rgba(0,0,0,.3);
            max-height:92vh;
            overflow-y:auto;
            /* FIX: Ensure modal content is never clipped by body transforms */
            transform: translateZ(0);
        }
        @keyframes slideDown { from{transform:translateY(-40px);opacity:0} to{transform:translateY(0);opacity:1} }
        .close-modal { position:absolute; right:18px; top:16px; font-size:30px; color:var(--muted); cursor:pointer; transition:color .2s; line-height:1; }
        .close-modal:hover { color:var(--orange); }
        .modal-content h2 { font-size:28px; font-weight:800; color:var(--dark); margin-bottom:8px; }
        .modal-content > p { color:var(--muted); margin-bottom:24px; font-size:15px; }
        .form-group { margin-bottom:18px; }
        .form-group label { display:block; font-weight:700; color:var(--mid); margin-bottom:7px; font-size:14px; }
        .form-group input, .form-group textarea {
            width:100%;
            padding:12px 14px;
            border:2px solid var(--border);
            border-radius:10px;
            font-size:15px;
            font-family:inherit;
            transition:border-color .2s;
            /* FIX: Prevent iOS zoom on focus */
            font-size: 16px;
        }
        .form-group input:focus, .form-group textarea:focus { outline:none; border-color:var(--orange); }
        .submit-btn { width:100%; padding:14px; background:linear-gradient(135deg,var(--orange),var(--orange-light)); color:white; font-weight:700; font-size:17px; border-radius:10px; cursor:pointer; transition:all .3s; border:none; font-family:inherit; }
        .submit-btn:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(255,123,25,.4); }

        /* WhatsApp submit channel row */
        .submit-channels { display:flex; gap:10px; margin-top:6px; }
        .submit-channels .submit-btn { flex:1; }
        .btn-wa-submit { flex:0 0 auto; padding:14px 18px; background:linear-gradient(135deg,#25D366,#128C7E); color:white; font-weight:700; font-size:15px; border-radius:10px; cursor:pointer; transition:all .3s; border:none; font-family:inherit; display:flex; align-items:center; gap:7px; white-space:nowrap; }
        .btn-wa-submit:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(37,211,102,.4); }
        .btn-wa-submit svg { width:20px; height:20px; }

        /* HERO */
        .hero { padding:90px 0 80px; background:linear-gradient(135deg,#fff8f3 0%,#ffffff 60%,#f0f8ff 100%); position:relative; overflow:hidden; }
        .hero::before { content:''; position:absolute; top:-200px; right:-200px; width:600px; height:600px; background:radial-gradient(circle,rgba(255,123,25,.08) 0%,transparent 70%); border-radius:50%; pointer-events:none; }
        .hero-content { display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; position:relative; z-index:1; }
        .hero-label { display:inline-flex; align-items:center; gap:8px; background:var(--orange-pale); border:1px solid rgba(255,123,25,.2); border-radius:30px; padding:7px 16px; font-size:13px; font-weight:700; color:var(--orange); margin-bottom:20px; }
        .hero-label span:first-child { width:7px; height:7px; background:var(--orange); border-radius:50%; display:inline-block; animation:pulse 1.5s infinite; }
        .hero-label span:last-child { width:auto; height:auto; background:none; animation:none; }
        .hero-text h1 { font-size:52px; font-weight:800; color:var(--dark); line-height:1.1; margin-bottom:22px; }
        .hero-text h1 .highlight { color:var(--orange); }
        .hero-text p { font-size:18px; color:var(--muted); margin-bottom:32px; line-height:1.75; }
        .hero-cta-row { display:flex; gap:14px; align-items:center; flex-wrap:wrap; }
        .hero-image img { border-radius:0px; box-shadow:0 0px 0px rgba(0,0,0,.12); transition:transform .3s; max-width:110%; height:auto; animation:float 7s ease-in-out infinite; }
        .hero-image img:hover { transform:scale(1.02); animation:none; }
        .hero-stats { display:flex; gap:32px; margin-top:40px; padding-top:32px; border-top:1px solid var(--border); }
        .stat-item { text-align:center; }
        .stat-number { font-size:32px; font-weight:800; color:var(--orange); line-height:1; }
        .stat-label { color:var(--muted); font-size:13px; margin-top:5px; font-weight:500; }

        /* TRUST */
        .trust-section { padding:48px 0; background:white; border-bottom:1px solid var(--border); }
        .trust-badges { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:nowrap; }
        .trust-item { text-align:center; flex:1; padding:16px 10px; border-radius:12px; transition:all .3s; cursor:default; }
        .trust-item:hover { background:var(--orange-pale); transform:translateY(-4px); }
        .trust-icon { font-size:36px; margin-bottom:8px; }
        .trust-text { font-weight:700; color:var(--mid); font-size:14px; }

        /* STATS */
        .stats-section { padding:80px 0; background:linear-gradient(135deg,var(--dark) 0%,#2d3748 100%); color:white; position:relative; overflow:hidden; }
        .stats-section::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 30% 50%,rgba(255,123,25,.15) 0%,transparent 60%); pointer-events:none; }
        .stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:40px; position:relative; z-index:1; }
        .stat-card { text-align:center; padding:32px 16px; border:1px solid rgba(255,255,255,.1); border-radius:16px; background:rgba(255,255,255,.04); transition:all .3s; }
        .stat-card:hover { border-color:var(--orange); background:rgba(255,123,25,.08); transform:translateY(-6px); }
        .stat-card .number { font-size:52px; font-weight:800; line-height:1; margin-bottom:10px; background:linear-gradient(135deg,#ffffff,#ffd4a8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
        .stat-card .label { font-size:15px; color:#a0aec0; font-weight:500; }
        .stat-card .stat-icon { font-size:28px; margin-bottom:12px; }

        /* FEATURE SHOWCASE */
        .feature-showcase { padding:100px 0; background:var(--bg-light); }
        .showcase-item { display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; margin-bottom:90px; }
        .showcase-item:last-child { margin-bottom:0; }
        .showcase-item.reverse { direction:rtl; }
        .showcase-item.reverse > * { direction:ltr; }
        .showcase-badge { display:inline-flex; align-items:center; gap:8px; padding:7px 16px; background:var(--orange-pale); border:1px solid rgba(255,123,25,.2); color:var(--orange); border-radius:30px; font-weight:700; font-size:13px; margin-bottom:16px; }
        .showcase-content h3 { font-size:34px; font-weight:800; color:var(--dark); margin-bottom:16px; line-height:1.2; }
        .showcase-content p { font-size:17px; color:var(--muted); line-height:1.75; margin-bottom:20px; }
        .showcase-image { position:relative; border-radius:16px; overflow:hidden; box-shadow:0 24px 64px rgba(0,0,0,.14); transition:all .4s; }
        .showcase-image:hover { transform:scale(1.025) translateY(-4px); box-shadow:0 32px 80px rgba(0,0,0,.2); }
        .showcase-image img { width:100%; height:auto; display:block; }
        .feature-check-list { list-style:none; margin-top:8px; }
        .feature-check-list li { display:flex; align-items:center; gap:10px; color:var(--mid); font-size:15px; margin-bottom:10px; font-weight:600; }
        .feature-check-list li::before { content:'✓'; display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; min-width:22px; background:linear-gradient(135deg,var(--orange),var(--orange-light)); color:white; border-radius:50%; font-size:11px; font-weight:800; }

        /* FEATURES GRID */
        .features { padding:100px 0; background:white; position:relative; overflow:hidden; }
        .features::before { content:''; position:absolute; top:-80px; right:-80px; width:400px; height:400px; background:radial-gradient(circle,rgba(255,123,25,.07) 0%,transparent 70%); border-radius:50%; pointer-events:none; }
        .features-header { text-align:center; margin-bottom:16px; }
        .features-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:24px; margin-top:56px; position:relative; z-index:1; }
        .feature-card { background:var(--bg-light); border:1.5px solid var(--border); border-radius:16px; padding:32px 28px; transition:all .35s cubic-bezier(.175,.885,.32,1.275); position:relative; overflow:hidden; }
        .feature-card::after { content:''; position:absolute; top:0; left:0; width:100%; height:3px; background:linear-gradient(90deg,var(--orange),var(--orange-light)); transform:scaleX(0); transform-origin:left; transition:transform .35s; }
        .feature-card:hover::after { transform:scaleX(1); }
        .feature-card:hover { transform:translateY(-10px); box-shadow:0 20px 40px rgba(255,123,25,.18); border-color:var(--orange); background:white; }
        .feature-icon { font-size:40px; margin-bottom:16px; display:inline-block; transition:transform .3s; }
        .feature-card:hover .feature-icon { transform:scale(1.15) rotate(6deg); }
        .feature-card h3 { font-size:18px; font-weight:800; color:var(--dark); margin-bottom:10px; }
        .feature-card p { color:var(--muted); font-size:14px; line-height:1.7; }
        .feature-new-badge { display:inline-block; background:linear-gradient(135deg,var(--orange),var(--orange-light)); color:white; font-size:10px; font-weight:800; padding:2px 9px; border-radius:20px; margin-bottom:10px; letter-spacing:.6px; text-transform:uppercase; }
        .feature-hot-badge { display:inline-block; background:linear-gradient(135deg,#e53e3e,#fc8181); color:white; font-size:10px; font-weight:800; padding:2px 9px; border-radius:20px; margin-bottom:10px; letter-spacing:.6px; text-transform:uppercase; }

        /* HOW IT WORKS */
        .how-it-works { padding:100px 0; background:var(--bg-light); }
        .steps-container { display:flex; gap:24px; margin-top:56px; justify-content:space-between; }
        .step-card { text-align:center; padding:32px 20px; border-radius:16px; background:white; border:1.5px solid var(--border); transition:all .3s; flex:1; }
        .step-card:hover { border-color:var(--orange); transform:translateY(-8px); box-shadow:0 16px 40px rgba(255,123,25,.15); }
        .step-number { width:64px; height:64px; background:linear-gradient(135deg,var(--orange),var(--orange-light)); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:26px; font-weight:800; margin:0 auto 20px; box-shadow:0 8px 20px rgba(255,123,25,.3); }
        .step-card h3 { font-size:18px; font-weight:800; color:var(--dark); margin-bottom:10px; }
        .step-card p { color:var(--muted); font-size:14px; }

        /* WORKFLOW */
        .workflow { padding:100px 0; background:white; }
        .workflow-timeline { display:flex; justify-content:space-between; margin-top:56px; position:relative; gap:16px; }
        .workflow-timeline::before { content:''; position:absolute; top:30px; left:10%; right:10%; height:2px; background:linear-gradient(90deg,var(--orange),var(--orange-light)); opacity:.3; }
        .workflow-step { flex:1; text-align:center; position:relative; }
        .workflow-number { width:60px; height:60px; background:linear-gradient(135deg,var(--orange),var(--orange-light)); color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:800; margin:0 auto 18px; box-shadow:0 4px 16px rgba(255,123,25,.3); animation:glow 2.5s ease-in-out infinite; transition:transform .3s; }
        .workflow-step:hover .workflow-number { transform:scale(1.2); animation:none; }
        .workflow-step h3 { font-size:16px; font-weight:800; color:var(--dark); margin-bottom:7px; }
        .workflow-step p { color:var(--muted); font-size:13px; }

        /* BENEFITS */
        .benefits { padding:100px 0; background:var(--bg-light); }
        .benefits-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:24px; margin-top:56px; }
        .benefit-item { display:flex; gap:18px; padding:28px; background:white; border:1.5px solid var(--border); border-radius:16px; transition:all .35s; position:relative; overflow:hidden; }
        .benefit-item::before { content:''; position:absolute; left:0; top:0; height:100%; width:4px; background:linear-gradient(180deg,var(--orange),var(--orange-light)); transform:scaleY(0); transition:transform .35s; border-radius:4px 0 0 4px; }
        .benefit-item:hover { transform:translateX(8px); box-shadow:0 10px 32px rgba(255,123,25,.14); border-color:var(--orange); }
        .benefit-item:hover::before { transform:scaleY(1); }
        .benefit-icon { font-size:36px; flex-shrink:0; transition:transform .3s; }
        .benefit-item:hover .benefit-icon { transform:scale(1.2) rotate(8deg); }
        .benefit-content h3 { font-size:18px; font-weight:800; color:var(--dark); margin-bottom:7px; transition:color .2s; }
        .benefit-item:hover .benefit-content h3 { color:var(--orange); }
        .benefit-content p { color:var(--muted); font-size:14px; line-height:1.7; }

        /* TESTIMONIALS */
        .testimonials { padding:100px 0; background:linear-gradient(135deg,#1a202c 0%,#2d3748 100%); color:white; }
        .testimonials .section-title { color:white; }
        .testimonials .section-subtitle { color:#a0aec0; }
        .testimonials-grid { display:flex; gap:24px; margin-top:56px; }
        .testimonial-card { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); border-radius:16px; padding:28px 24px; transition:all .35s; flex:1; }
        .testimonial-card:hover { transform:translateY(-8px); background:rgba(255,255,255,.08); border-color:var(--orange); box-shadow:0 16px 40px rgba(255,123,25,.25); }
        .testimonial-name { font-weight:800; color:var(--orange); font-size:18px; margin-bottom:4px; }
        .testimonial-role { font-size:13px; color:#a0aec0; margin-bottom:14px; }
        .stars { color:#FFD700; font-size:18px; margin-bottom:14px; letter-spacing:2px; }
        .testimonial-text { font-size:14px; font-style:italic; color:#e2e8f0; line-height:1.75; }

        /* CLIENTS */
        .clients-section { padding:80px 0; background:white; overflow:hidden; }
        .clients-header { text-align:center; margin-bottom:48px; }
        .clients-track-wrapper { position:relative; width:100%; overflow:hidden; }
        .clients-track-wrapper::before,.clients-track-wrapper::after { content:''; position:absolute; top:0; width:100px; height:100%; z-index:2; pointer-events:none; }
        .clients-track-wrapper::before { left:0; background:linear-gradient(to right,white 0%,transparent 100%); }
        .clients-track-wrapper::after { right:0; background:linear-gradient(to left,white 0%,transparent 100%); }
        .clients-track { display:flex; gap:20px; width:max-content; animation:clientsScroll 28s linear infinite; }
        @keyframes clientsScroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
        .client-card { flex-shrink:0; width:190px; height:110px; background:var(--bg-light); border:1.5px solid var(--border); border-radius:14px; display:flex; align-items:center; justify-content:center; padding:14px; transition:all .3s; cursor:pointer; }
        .client-card:hover { border-color:var(--orange); background:white; transform:translateY(-5px); box-shadow:0 12px 28px rgba(255,123,25,.15); }
